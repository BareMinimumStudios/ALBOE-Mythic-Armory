  "item.alboe_mythicarmory.solaris_edge": "Solaris Edge",
  "item.alboe_mythicarmory.solaris_edge.tooltip1": "Divine Passive: Horizon Shift",
  "item.alboe_mythicarmory.solaris_edge.tooltip2.day": "During the day, your blade glows brighter, and gains %s%% bonus damage",
  "item.alboe_mythicarmory.solaris_edge.tooltip3.day": "and regens %sHP every %ss. At night, it gets %s%% weaker and loses this effect.",
  "item.alboe_mythicarmory.solaris_edge.tooltip2.night": "During the night, your blade shifts to be more defensive.",
  "item.alboe_mythicarmory.solaris_edge.tooltip3.night": "Gain %s%% damage resistance and regen %sHP every %ss.",
  "item.alboe_mythicarmory.solaris_edge.tooltip4": "Divine Ability: Eclipse Invocation",
  "item.alboe_mythicarmory.solaris_edge.tooltip5.day": "Right-click to launch a solar flare in a wide arc,",
  "item.alboe_mythicarmory.solaris_edge.tooltip6.day": "blinding all enemies for 3s, and dealing fire DoT for 5s.",
  "item.alboe_mythicarmory.solaris_edge.tooltip7.day": "This ability is lost at night and uses up the meter if fully charged.",
  "item.alboe_mythicarmory.solaris_edge.tooltip5.night": "At night, Right-click to create an eclipse shield",
  "item.alboe_mythicarmory.solaris_edge.tooltip6.night": "composed of lunar energy, absorbing 50% of incoming damage",
  "item.alboe_mythicarmory.solaris_edge.tooltip7.night": "in front for 5s. Reflect 15% of blocked damage to enemies",
  "item.alboe_mythicarmory.solaris_edge.tooltip8.night": "in a 5-block AoE and causes Blindness.",
  "item.alboe_mythicarmory.solaris_edge.tooltip9": "Bonus Effect: Solar Overload",
  "item.alboe_mythicarmory.solaris_edge.tooltip10": "This weapon powers up in direct sunlight for %ss.",
  "item.alboe_mythicarmory.solaris_edge.tooltip11": "Empowers daytime right-click with increased range and explosive damage.",

  "item.alboe_mythicarmory.sky_thresher": "Sky Thresher",
  "item.alboe_mythicarmory.sky_thresher.tooltip1": "Divine Passive: Zephyr",
  "item.alboe_mythicarmory.sky_thresher.tooltip2": "Grants enhanced jump height, speed, and allows slow fall for %ss",
  "item.alboe_mythicarmory.sky_thresher.tooltip3": "using [%s] until energy is depleted. Recharges when on the ground.",
  "item.alboe_mythicarmory.sky_thresher.tooltip4": "At night gain a dash using [%s] which has a %ss cooldown.",
  "item.alboe_mythicarmory.sky_thresher.tooltip5": "Divine Passive: Mistral",
  "item.alboe_mythicarmory.sky_thresher.tooltip6": "Each attack has a %s%% chance to summon a vortex of stardust,",
  "item.alboe_mythicarmory.sky_thresher.tooltip7": "which slightly pulls enemies and causes nausea.",
  "item.alboe_mythicarmory.sky_thresher.tooltip8": "Divine Ability: Nebula Storm",
