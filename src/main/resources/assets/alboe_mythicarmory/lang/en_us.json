  "item.alboe_mythicarmory.solaris_edge": "Solaris Edge",
  "item.alboe_mythicarmory.solaris_edge.tooltip1": "Divine Passive: Horizon Shift",
  "item.alboe_mythicarmory.solaris_edge.tooltip2": "During the day, your blade glows brighter, and gains %s%% bonus damage",
  "item.alboe_mythicarmory.solaris_edge.tooltip3": "and regens %sHP every %ss. At night, it gets %s%% weaker and loses this effect.",
  "item.alboe_mythicarmory.solaris_edge.tooltip4": "During the night, your blade shifts to be more defensive.",
  "item.alboe_mythicarmory.solaris_edge.tooltip5": "Gain %s%% damage resistance and regen %sHP every %ss.",
  "item.alboe_mythicarmory.solaris_edge.tooltip6": "Divine Ability: Eclipse Invocation",
  "item.alboe_mythicarmory.solaris_edge.tooltip7": "Right-click to launch a solar flare in a wide arc,",
  "item.alboe_mythicarmory.solaris_edge.tooltip8": "blinding all enemies for 3s, and dealing fire DoT for 5s.",
  "item.alboe_mythicarmory.solaris_edge.tooltip9": "This ability is lost at night and uses up the meter if fully charged.",
  "item.alboe_mythicarmory.solaris_edge.tooltip10": "At night, Right-click to create an eclipse shield",
  "item.alboe_mythicarmory.solaris_edge.tooltip11": "composed of lunar energy, absorbing 50% of incoming damage",
  "item.alboe_mythicarmory.solaris_edge.tooltip12": "in front for 5s. Reflect 15% of blocked damage to enemies",
  "item.alboe_mythicarmory.solaris_edge.tooltip13": "in a 5-block AoE and causes Blindness.",
  "item.alboe_mythicarmory.solaris_edge.tooltip14": "Bonus Effect: Solar Overload",
  "item.alboe_mythicarmory.solaris_edge.tooltip15": "This weapon powers up in direct sunlight for %ss.",
  "item.alboe_mythicarmory.solaris_edge.tooltip16": "Empowers daytime right-click with increased range and explosive damage.",

  "item.alboe_mythicarmory.sky_thresher": "Sky Thresher",
  "item.alboe_mythicarmory.sky_thresher.tooltip1": "Divine Passive: Zephyr",
  "item.alboe_mythicarmory.sky_thresher.tooltip2": "Grants enhanced jump height, speed, and allows gliding for %ss",
  "item.alboe_mythicarmory.sky_thresher.tooltip3": "until energy is depleted. Recharges within %ss.",
  "item.alboe_mythicarmory.sky_thresher.tooltip4": "At night gain a double-tap dash in any direction which has a",
  "item.alboe_mythicarmory.sky_thresher.tooltip5": "%ss cooldown. Leaves behind a trail of clouds with each dash.",
  "item.alboe_mythicarmory.sky_thresher.tooltip6": "Divine Passive: Mistral",
  "item.alboe_mythicarmory.sky_thresher.tooltip7": "Each attack has a %s%% chance to summon a vortex of stardust,",
  "item.alboe_mythicarmory.sky_thresher.tooltip8": "which slightly pulls enemies and causes nausea.",
  "item.alboe_mythicarmory.sky_thresher.tooltip9": "Divine Ability: Nebula Storm",
  "item.alboe_mythicarmory.sky_thresher.tooltip10": "Right-click to unleash a swirling nebula in front of you,",
  "item.alboe_mythicarmory.sky_thresher.tooltip11": "dealing damage over time AoE magic damage, pulling enemies near",
  "item.alboe_mythicarmory.sky_thresher.tooltip12": "its center and moves them around violently.",
  "item.alboe_mythicarmory.sky_thresher.tooltip13": "After 5s seconds, the core bursts into a burst of light -",
